{
  "name": "domestic-ui",
  "version": "0.1.0",
  "private": true,
  "description": "A standards-first design system built on native HTML, CSS custom properties, and cascade layers.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odonckers/domestic-ui.git"
  },
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "gridlines": "node scripts/gridlines.mjs",
    "lint:html": "html-validate \"examples/**/*.html\"",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "test:a11y": "playwright test",
    "test:visual": "playwright test tests/visual.spec.js --project=chromium",
    "test:visual:update": "playwright test tests/visual.spec.js --project=chromium --update-snapshots",
    "test": "npm run lint:html && npm run lint:css && npm run lint:tokens && npm run test:a11y",
    "changelog": "node scripts/changelog.mjs",
    "changelog:check": "node scripts/changelog.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.1",
    "git-cliff": "2.14.2",
    "html-validate": "11.21.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0"
  }
}
