{
  "apps": [
    { "id": "vanilla", "title": "Plain HTML" },
    { "id": "react", "title": "React" },
    { "id": "angular", "title": "Angular" },
    { "id": "astro", "title": "Astro" }
  ],
  "views": [
    {
      "id": "dashboard",
      "title": "Dashboard",
      "description": "Household chores: counts due, overdue and done, household members, and a table of upcoming chores with a filter disclosure.",
      "paths": {
        "vanilla": "demos/vanilla/index.html",
        "react": "demos/react/src/DashboardPage.tsx",
        "angular": "demos/angular/src/app/dashboard",
        "astro": "demos/astro/src/pages/index.astro"
      },
      "pages": ["layouts/app-shell", "components/molecules/nav", "components/molecules/menu-button", "components/molecules/popover", "components/molecules/disclosure", "layouts/dashboard", "components/organisms/data-table"]
    },
    {
      "id": "settings",
      "title": "Account settings",
      "description": "A long form in titled sections: profile, region, email frequency, notification switches and a note for the household, with Save and Cancel in an action bar.",
      "paths": {
        "vanilla": "demos/vanilla/settings.html",
        "react": "demos/react/src/SettingsPage.tsx",
        "angular": "demos/angular/src/app/settings",
        "astro": "demos/astro/src/pages/settings.astro"
      },
      "pages": ["layouts/app-shell", "components/molecules/nav", "components/molecules/menu-button", "components/molecules/popover", "components/organisms/large-forms"]
    },
    {
      "id": "orders",
      "title": "Orders",
      "description": "A warehouse admin view: page header, filter bar with typeaheads, a data table with a density toggle, and the selected order in the auxiliary sidebar.",
      "paths": {
        "vanilla": "demos/vanilla/orders.html",
        "react": "demos/react/src/OrdersPage.tsx",
        "angular": "demos/angular/src/app/orders",
        "astro": "demos/astro/src/pages/orders.astro"
      },
      "pages": [
        "layouts/app-shell",
        "components/molecules/nav",
        "components/molecules/menu-button",
        "components/molecules/popover",
        "components/molecules/breadcrumb",
        "components/organisms/filter-bar",
        "components/molecules/combobox",
        "components/organisms/data-table",
        "components/molecules/toolbar",
        "tokens/density",
        "layouts/list-detail",
        "components/organisms/page-header"
      ],
      "notes": { "layouts/app-shell": "with the auxiliary sidebar" }
    }
  ]
}
