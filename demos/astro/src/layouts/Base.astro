---
import "../../../../css/domestic.css";

interface Props {
	title: string;
	description: string;
	current: "dashboard" | "settings" | "orders";
}

const { title, description, current } = Astro.props;
// The auxiliary sidebar is optional: a page passes one as <aside slot="aux">.
const hasAux = Astro.slots.has("aux");

const links = [
	{
		view: "dashboard",
		href: "/",
		label: "Dashboard",
		icon: '<path d="M3 11.5 12 4l9 7.5M5 10v10h14V10"></path>',
	},
	{
		view: "orders",
		href: "/orders/",
		label: "Orders",
		icon: '<path d="M3 4h2l2.5 11h11L21 7H6.2"></path><circle cx="9" cy="19.5" r="1.5"></circle><circle cx="17" cy="19.5" r="1.5"></circle>',
	},
	{
		view: "settings",
		href: "/settings/",
		label: "Account settings",
		icon: '<path d="M4 6h10M4 12h4M12 12h8M4 18h12"></path><circle cx="16" cy="6" r="2"></circle><circle cx="10" cy="12" r="2"></circle><circle cx="18" cy="18" r="2"></circle>',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · Homebase</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<a class="visually-hidden" href="#main">Skip to main content</a>

		<dui-app-shell data-app-shell>
			<header>
				<button type="button" aria-controls="app-nav" aria-expanded="true" hidden>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
					Menu
				</button>
				<a href="/" data-link="quiet"><strong>Homebase</strong></a>
				{hasAux && (
					<button type="button" aria-controls="app-aux" aria-expanded="true" hidden>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M15 4v16"></path></svg>
						Details
					</button>
				)}
				<dui-menu>
					<button type="button" popovertarget="user-menu">Sam Rivera</button>
					<div id="user-menu" popover data-popover>
						<button type="button">Profile</button>
						<button type="button">Preferences</button>
						<hr />
						<button type="button">Sign out</button>
					</div>
				</dui-menu>
			</header>

			<nav id="app-nav" aria-label="Main" data-nav="vertical">
				<ul>
					{links.map(({ view, href, label, icon }) => (
						<li>
							<a href={href} aria-current={view === current ? "page" : undefined}>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon} />
								{label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			<main id="main" class="stack">
				<slot />
			</main>

			<slot name="aux" />

			<footer>
				<p data-text="small muted">Homebase is a domestic-ui demo app. MIT licensed.</p>
			</footer>
		</dui-app-shell>
		<script>
			import "../../../../web-components/dui-app-shell.js";
			import "../../../../web-components/dui-menu.js";
		</script>
	</body>
</html>
